meta {
  name: Listar historico de versoes
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/collaborators/{{collaboratorId}}/documents/{{documentTypeId}}/submissions
  body: none
  auth: none
}

vars:pre-request {
  baseUrl: localhost:3000
}

tests {
  test("Status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Retorna as 3 versoes ordenadas desc, apenas a mais recente ativa", function() {
    const body = res.getBody();
    expect(body).to.have.lengthOf(3);
    expect(body[0].version).to.equal(3);
    expect(body[0].isCurrentVersion).to.equal(true);
    expect(body[1].version).to.equal(2);
    expect(body[1].isCurrentVersion).to.equal(false);
    expect(body[2].version).to.equal(1);
    expect(body[2].isCurrentVersion).to.equal(false);
  });
}
