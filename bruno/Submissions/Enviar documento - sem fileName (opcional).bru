meta {
  name: Enviar documento - sem fileName (opcional)
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/collaborators/{{collaboratorId}}/documents/{{documentTypeId}}/submissions
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {}
}

vars:pre-request {
  baseUrl: localhost:3000
}

tests {
  test("Status 201", function() {
    expect(res.getStatus()).to.equal(201);
  });

  test("Cria a versao 3 sem fileName", function() {
    const body = res.getBody();
    expect(body.version).to.equal(3);
    expect(body.isCurrentVersion).to.equal(true);
    expect(body.fileName).to.equal(null);
  });
}
