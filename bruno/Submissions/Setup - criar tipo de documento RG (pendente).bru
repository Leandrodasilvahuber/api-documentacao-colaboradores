meta {
  name: Setup - criar tipo de documento RG (pendente)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/document-types
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "RG Submissions",
    "description": "Fica sem envio, usado nos testes de documentos pendentes"
  }
}

vars:pre-request {
  baseUrl: localhost:3000
}

script:post-response {
  if (res.getStatus() === 201) {
    const body = res.getBody();
    bru.setVar('documentTypeId2', body.id);
  }
}

tests {
  test("Status 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
}
