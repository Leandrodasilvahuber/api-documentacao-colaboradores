meta {
  name: Setup - criar colaborador
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/collaborators
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Colaborador Vinculos",
    "email": "colaborador.vinculos@example.com"
  }
}

vars:pre-request {
  baseUrl: localhost:3000
}

script:post-response {
  if (res.getStatus() === 201) {
    const body = res.getBody();
    bru.setVar('collaboratorId', body.id);
  }
}

tests {
  test("Status 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
}
