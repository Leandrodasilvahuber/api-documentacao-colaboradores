meta {
  name: Vincular tipos de documento - IDs duplicados no payload
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/collaborators/{{collaboratorId}}/documents
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "documentTypeIds": ["{{documentTypeId3}}", "{{documentTypeId3}}"]
  }
}

vars:pre-request {
  baseUrl: localhost:3000
}

tests {
  test("Status 201", function() {
    expect(res.getStatus()).to.equal(201);
  });

  test("Deduplica IDs repetidos no mesmo payload, criando um unico vinculo", function() {
    const body = res.getBody();
    expect(body.created).to.have.lengthOf(1);
    expect(body.reactivated).to.have.lengthOf(0);
  });
}
