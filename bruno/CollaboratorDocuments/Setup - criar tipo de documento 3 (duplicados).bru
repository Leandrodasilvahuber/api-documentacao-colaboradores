meta {
  name: Setup - criar tipo de documento 3 (duplicados)
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/document-types
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "CNH Vinculos",
    "description": "Usado no teste de IDs duplicados no payload de vinculo"
  }
}

vars:pre-request {
  baseUrl: localhost:3000
}

script:post-response {
  if (res.getStatus() === 201) {
    const body = res.getBody();
    bru.setVar('documentTypeId3', body.id);
  }
}

tests {
  test("Status 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
}
