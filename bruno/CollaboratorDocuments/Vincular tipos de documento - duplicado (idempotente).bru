meta {
  name: Vincular tipos de documento - duplicado (idempotente)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/collaborators/{{collaboratorId}}/documents
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "documentTypeIds": ["{{documentTypeId}}"]
  }
}

vars:pre-request {
  baseUrl: localhost:3000
}

tests {
  test("Status 201", function() {
    expect(res.getStatus()).to.equal(201);
  });

  test("Ignora silenciosamente o vinculo ja ativo", function() {
    const body = res.getBody();
    expect(body.created).to.have.lengthOf(0);
    expect(body.reactivated).to.have.lengthOf(0);
  });
}
