        },
        {
          "name": "Listar colaboradores (paginado)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Possui data e meta', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('data');",
                  "  pm.expect(body).to.have.property('meta');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/collaborators?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["collaborators"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
