// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// email tem um índice único parcial no banco (WHERE deleted_at IS NULL), criado à mão em
// prisma/migrations/20260728013516_create_collaborator_table/migration.sql — não é
// representável aqui via @unique/@@unique porque o Prisma Schema Language não suporta
// índices únicos parciais (WHERE); um @unique puro quebraria o reaproveitamento de email
// de colaboradores soft-deletados.
model Collaborator {
  id        String    @id @default(uuid())
  name      String
  email     String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  documents CollaboratorDocumentType[]

  @@map("collaborators")
}

// name tem um índice único parcial no banco (WHERE deleted_at IS NULL), criado à mão em
// prisma/migrations/20260728204106_create_document_type_table/migration.sql — não é
// representável aqui via @unique/@@unique pelo mesmo motivo do Collaborator.email acima.
model DocumentType {
  id          String    @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  collaborators CollaboratorDocumentType[]

  @@map("document_types")
}

model CollaboratorDocumentType {
  id             String    @id @default(uuid())
  collaboratorId String    @map("collaborator_id")
  documentTypeId String    @map("document_type_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  deletedAt      DateTime? @map("deleted_at")

  collaborator Collaborator         @relation(fields: [collaboratorId], references: [id])
  documentType DocumentType         @relation(fields: [documentTypeId], references: [id])
  submissions  DocumentSubmission[]

  @@unique([collaboratorId, documentTypeId])
  @@map("collaborator_document_types")
}

model DocumentSubmission {
  id                         String   @id @default(uuid())
  collaboratorDocumentTypeId String   @map("collaborator_document_type_id")
  version                    Int
  isCurrentVersion           Boolean  @default(true) @map("is_current_version")
  fileName                   String?  @map("file_name")
  submittedAt                DateTime @default(now()) @map("submitted_at")

  collaboratorDocumentType CollaboratorDocumentType @relation(fields: [collaboratorDocumentTypeId], references: [id])

  @@unique([collaboratorDocumentTypeId, version])
  @@map("document_submissions")
}
