// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Collaborator {
  id        String    @id @default(uuid())
  name      String
  email     String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  documents CollaboratorDocumentType[]

  @@map("collaborators")
}

model DocumentType {
  id          String    @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  collaborators CollaboratorDocumentType[]

  @@map("document_types")
}

model CollaboratorDocumentType {
  id             String    @id @default(uuid())
  collaboratorId String    @map("collaborator_id")
  documentTypeId String    @map("document_type_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  deletedAt      DateTime? @map("deleted_at")

  collaborator   Collaborator @relation(fields: [collaboratorId], references: [id])
  documentType   DocumentType @relation(fields: [documentTypeId], references: [id])

  @@unique([collaboratorId, documentTypeId])
  @@map("collaborator_document_types")
}
